# -----------------------------------------------------------------------------
# API keys for Knowledge-to-Equation.
# Copy this file to config/.env and fill in your real keys.
#   cp config/.env.example config/.env
# config/.env is git-ignored and must never be committed.
# -----------------------------------------------------------------------------

# OpenAI key (used for the LLM, embeddings and equation generation).
OPENAI_API_KEY=

# Optional. Set this for regional OpenAI keys that require a regional host,
# for example: https://us.api.openai.com/v1
OPENAI_BASE_URL=

# LlamaCloud / LlamaParse key (used to parse the literature PDFs).
LLAMA_CLOUD_API_KEY=
